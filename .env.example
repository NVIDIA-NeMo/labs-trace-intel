# Insight compilation configuration.
#
# Copy to `.env` and fill in the key:   cp .env.example .env
# `.env` is gitignored; this template is not. IA2 and IA3 need no credentials;
# Insight compilation uses the NVIDIA LiteLLM-compatible inference gateway.
#
# Precedence: CLI flag > exported environment variable > `.env`.

# --- Model and credential --------------------------------------------------
#
# The gateway exposes provider/model aliases. The leading `openai/` tells
# LiteLLM to use its OpenAI-compatible transport; the remainder is sent to the
# gateway as the model name.

INFERENCE_MODEL=openai/azure/openai/gpt-5.6-luna
INFERENCE_API_KEY=
INFERENCE_API_BASE=https://inference-api.nvidia.com/v1

# --- Internal Artifactory publishing --------------------------------------
#
# Used only by `uv run tools/publish_artifactory.py`. The URL is the PyPI upload
# endpoint, not the `/simple` package index URL.

ARTIFACTORY_PYPI_URL=
ARTIFACTORY_TOKEN=

# The legacy INSIGHT_AGENT_* names are accepted as migration fallbacks, but
# should not be used in new configurations.
