# Copy to .env and fill in the settings you need.
# Model setup and data access: docs/model-access.md
# Exported variables take priority over .env.

# Inference (separate from your trace-platform credentials).
INSIGHT_AGENT_MODEL=
INSIGHT_AGENT_API_KEY=
# Set only for a custom inference endpoint.
INSIGHT_AGENT_API_BASE=

# LangSmith: docs/sources/langsmith.md
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=

# Langfuse: docs/sources/langfuse.md
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# MLflow: docs/sources/mlflow.md
MLFLOW_TRACKING_URI=
# Use a bearer token or a username/password pair.
MLFLOW_TRACKING_TOKEN=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# NeMo Platform Intake: docs/sources/intake.md
NMP_ACCESS_TOKEN=

# Internal release publishing only: DEVELOPMENT.md
ARTIFACTORY_PYPI_URL=
ARTIFACTORY_TOKEN=
