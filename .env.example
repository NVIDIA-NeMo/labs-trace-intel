# Trace Analyst configuration.
#
# Copy to `.env` and fill in the values:   cp .env.example .env
# `.env` is gitignored; this template is not. Trace Analyst reads its variables,
# and the local Artifactory publishing tool reads only its variables. The
# deterministic evidence streams need no credentials at all.
#
# Precedence: CLI flag > exported environment variable > `.env`.

# --- Model and credential --------------------------------------------------
#
# Any litellm model string works; see https://docs.litellm.ai/docs/providers
# for the format. Anthropic direct is the package default.

INSIGHT_AGENT_MODEL=
# Credential for the inference provider selected by INSIGHT_AGENT_MODEL.
# This is unrelated to trace-source credentials such as LANGSMITH_API_KEY.
INSIGHT_AGENT_API_KEY=
# Optional. Leave blank when the selected provider uses its default endpoint.
# For a custom endpoint, use the API base exactly as that provider documents
# it. OpenAI-compatible gateways commonly end in `/v1`; do not guess that
# suffix or append `/chat/completions` unless the provider explicitly includes
# it in the API base.
INSIGHT_AGENT_API_BASE=

# --- Optional LangSmith trace source --------------------------------------
#
# Project credentials and SDK defaults used only when trace.langsmith is
# selected. LANGSMITH_ENDPOINT can be left blank for the SDK default.

LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=

# --- Optional Braintrust trace source -------------------------------------
# Used only when trace.braintrust is selected. API URL defaults to the US region.

BRAINTRUST_API_KEY=
BRAINTRUST_API_URL=

# --- Optional Langfuse trace source ---------------------------------------
#
# Project-scoped credentials used only when trace.langfuse is selected.

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# --- Optional MLflow trace source -----------------------------------------
#
# Tracking server settings used only when trace.mlflow_experiment is selected.
# Choose either username/password or bearer-token authentication when needed.

MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_TRACKING_TOKEN=

# --- Internal Artifactory publishing --------------------------------------
#
# Used only by `uv run tools/publish_artifactory.py`. The URL is the PyPI upload
# endpoint, not the `/simple` package index URL.

ARTIFACTORY_PYPI_URL=
ARTIFACTORY_TOKEN=

# --- Alternatives ----------------------------------------------------------
#
# OpenAI direct:
#   INSIGHT_AGENT_MODEL=openai/gpt-5.2
#   INSIGHT_AGENT_API_KEY=sk-...
#
# Bedrock:
#   INSIGHT_AGENT_MODEL=bedrock/anthropic.claude-opus-5
#
# Any OpenAI-compatible gateway — set an api_base alongside an `openai/` model
# prefix. Note that litellm strips the FIRST `openai/` to select the provider,
# so a gateway whose own model names already start with `openai/` needs it
# twice. Include `/v1` when the gateway documents that as its API base.
#
#   INSIGHT_AGENT_API_BASE=https://your-gateway.example.com/v1
#   INSIGHT_AGENT_MODEL=openai/your-model-name
#   INSIGHT_AGENT_API_KEY=...

# INSIGHT_AGENT_API_BASE=

# OPENAI_API_KEY / OPENAI_API_BASE / ANTHROPIC_API_KEY are also honoured as
# fallbacks, so an environment already set up for litellm needs no changes.
